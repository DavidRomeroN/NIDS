# Copiar a .env y cambiar ambos valores antes de levantar el stack.
# desplegar.sh genera valores aleatorios automáticamente si .env no existe.

# Contraseña del usuario admin de Grafana (único puerto abierto a internet).
GRAFANA_ADMIN_PASSWORD=cambiar-esto

# Clave HMAC para seudonimizar las IP antes de que entren a Kafka (Ley 29733).
# Si se cambia, los seudónimos dejan de coincidir con los anteriores.
SECRETO_SEUDONIMO=cambiar-esto
